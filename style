:root{--bg:#f5f3ee;--card:#fff;--soft:#f8f7f3;--text:#23251f;--muted:#6d7168;--line:#dedfd8;--accent:#315f46;--danger:#ad3d38}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px "Segoe UI",sans-serif}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:11px;padding:10px 13px;background:var(--card)}.primary{background:var(--accent);color:white;border-color:var(--accent)}.danger{color:var(--danger)}header,main{max-width:1440px;margin:auto}.appHeader{display:flex;justify-content:space-between;align-items:center;padding:26px 30px 8px}.appHeader nav,.nav,.views,.actions,.shoppingToolbar{display:flex;gap:9px;align-items:center}h1,h2,p{margin:0}small{color:var(--accent);font-weight:800;letter-spacing:.14em}main{padding:18px 30px 40px}.toolbar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:15px;border:1px solid var(--line);border-radius:20px;background:var(--card)}.period{text-align:center}.period p{color:var(--muted);font-size:.85rem}.views{justify-self:end}.views .active{background:var(--accent);color:#fff}.calendar{display:grid;gap:10px;margin-top:18px}.calendar.week,.calendar.month{grid-template-columns:repeat(7,minmax(0,1fr))}.weekday{text-align:center;color:var(--muted);font-weight:700}.day{min-height:220px;padding:13px;border:1px solid var(--line);border-radius:16px;background:var(--card)}.day.outside{opacity:.45}.day.today{box-shadow:inset 0 0 0 2px var(--accent)}.dayHead{display:flex;justify-content:space-between;gap:5px;margin-bottom:15px}.dayName{color:var(--accent);font-weight:800}.dayDate{color:var(--muted);font-size:.82rem}.meal{padding:11px;border-left:5px solid var(--meal);border-radius:11px;background:color-mix(in srgb,var(--meal) 14%,var(--card));cursor:pointer}.mealBadge{font-size:.72rem;font-weight:800;margin-bottom:7px}.mealTitle{font-weight:800}.mealNote{font-size:.82rem;color:var(--muted);margin-top:5px}.addMeal{width:100%;min-height:80px;border-style:dashed;color:var(--muted)}dialog{width:min(600px,calc(100% - 20px));border:1px solid var(--line);border-radius:21px;padding:0;background:var(--card);color:var(--text)}dialog::backdrop{background:#0008}.wideDialog{width:min(1000px,calc(100% - 20px));height:min(780px,calc(100vh - 20px));overflow:hidden}form,.dialogShell{padding:21px}.dialogShell{height:100%;display:flex;flex-direction:column;gap:11px}.dialogHead{display:flex;justify-content:space-between;align-items:flex-start}label,legend{display:block;font-weight:750;margin:15px 0 7px}input,textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:12px;background:var(--soft)}fieldset{border:0;padding:0}.categories,.filters{display:flex;flex-wrap:wrap;gap:7px}.cat.active,.filter.active{background:var(--cat);color:#fff}.moveSection{display:grid;grid-template-columns:1fr 180px auto;gap:9px;align-items:center;margin-top:18px;padding:12px;background:var(--soft);border-radius:13px}.moveSection[hidden]{display:none}.actions{margin-top:20px;flex-wrap:wrap}.actions span{flex:1}.suggestions{position:absolute;z-index:5;background:var(--card);border:1px solid var(--line);border-radius:11px;box-shadow:0 12px 30px #0002;max-height:220px;overflow:auto}.suggestion{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);border-radius:0}.list{flex:1;min-height:0;overflow:auto}.listItem{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;min-height:58px;padding:9px 11px;border:1px solid var(--line);border-radius:13px;background:var(--soft);margin-bottom:7px}.itemActions{display:flex;gap:7px}.pages{display:flex;justify-content:center;gap:6px}.pages .active{background:var(--accent);color:#fff}.shoppingForm{display:grid;grid-template-columns:minmax(0,1fr) 180px auto auto;gap:8px;padding:12px;background:var(--soft);border-radius:13px}.shoppingForm[hidden]{display:none}.shoppingPrint{display:none}#dashboard{margin-top:18px;padding:18px;background:var(--card);border-radius:16px}#toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,15px);opacity:0;background:var(--text);color:var(--card);padding:9px 15px;border-radius:99px;transition:.2s}#toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:900px){.appHeader,main{padding-left:14px;padding-right:14px}.appHeader{align-items:flex-start}.appHeader nav{flex-wrap:wrap;justify-content:flex-end}.toolbar{grid-template-columns:1fr 1fr}.period{grid-column:1/-1;grid-row:1}.calendar.week{grid-template-columns:1fr}.calendar.month{gap:5px}.shoppingForm,.moveSection{grid-template-columns:1fr}.listItem{grid-template-columns:1fr}.itemActions button{flex:1}.itemActions{width:100%}}

/* Einkaufsliste: sichtbare Trennung zwischen Artikel und Menge */
#shoppingList .listItem > div:first-child {
  display: flex;
  align-items: baseline;
  gap: 18px;
  min-width: 0;
}
#shoppingList .listItem > div:first-child b {
  display: inline-block;
  min-width: 0;
}
#shoppingList .listItem > div:first-child small {
  display: inline-block;
  margin-left: 0;
  color: var(--accent);
  font-weight: 800;
  letter-spacing: .08em;
  white-space: nowrap;
}
@media(max-width:700px){
  #shoppingList .listItem > div:first-child {gap:12px;flex-wrap:wrap}
}
